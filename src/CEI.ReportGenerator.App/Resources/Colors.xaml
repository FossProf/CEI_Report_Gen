<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical template-derived CEI colors -->
    <Color x:Key="CeiCharcoalColor">#58585A</Color>
    <Color x:Key="CeiGoldColor">#9D782C</Color>
    <Color x:Key="CeiTealColor">#5B8C9C</Color>
    <Color x:Key="CeiTealSecondaryColor">#5C92A0</Color>
    <Color x:Key="CeiSupportingGrayColor">#6E6E6E</Color>
    <Color x:Key="CeiWhiteColor">#FFFFFF</Color>

    <!-- Derived application neutrals -->
    <Color x:Key="CeiBackgroundColor">#F5F6F6</Color>
    <Color x:Key="CeiPanelColor">#FFFFFF</Color>
    <Color x:Key="CeiBorderColor">#D7DADB</Color>
    <Color x:Key="CeiTextColor">#333333</Color>
    <Color x:Key="CeiMutedTextColor">#6E6E6E</Color>
    <Color x:Key="CeiHeaderTintColor">#EAF1F3</Color>
    <Color x:Key="CeiSelectionColor">#DCEBED</Color>
    <Color x:Key="CeiSelectionBorderColor">#8DAEB7</Color>
    <Color x:Key="CeiHoverColor">#EDF4F5</Color>
    <Color x:Key="CeiTealDarkColor">#4F7A87</Color>
    <Color x:Key="CeiTealDarkerColor">#436A75</Color>
    <Color x:Key="CeiGoldTintColor">#F3EAD7</Color>
    <Color x:Key="CeiReadyColor">#2F7D5A</Color>
    <Color x:Key="CeiWarningColor">#9D782C</Color>
    <Color x:Key="CeiErrorColor">#B24A3D</Color>
    <Color x:Key="CeiErrorTintColor">#F7E6E3</Color>
</ResourceDictionary>
