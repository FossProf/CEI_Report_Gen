<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CEI.ReportGenerator.App</RootNamespace>
    <AssemblyName>CEI.ReportGenerator.App</AssemblyName>
    <Product>SPINgen</Product>
    <AssemblyTitle>SPINgen</AssemblyTitle>
    <Company>Cornerstone Engineering / CEI</Company>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0-alpha</InformationalVersion>
    <Description>Windows desktop application for creating standardized SPIN reports.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CEI.ReportGenerator.Core\CEI.ReportGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\CEI_Cornerstone_Logo_No_Tagline_Transparent.png"
              Link="Assets\Brand\CEI_Cornerstone_Logo_No_Tagline_Transparent.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\templates\CEI_Base_Template_Refined.docx" Link="Templates\CEI_Base_Template_Refined.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
