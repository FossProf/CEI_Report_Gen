<Window x:Class="CEI.ReportGenerator.App.Views.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Setup"
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionDividerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder2OpenGeometry}" Style="{StaticResource SectionIconPath}"/>
                        <TextBlock Text="Project Configuration" Style="{StaticResource PageTitleText}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Project name *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Cornerstone Project No. *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Owner *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OwnerBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Contract manager *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ContractBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="General contractor *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="GeneralBox" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="ProjectLocationLabel" Text="Project location *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource FieldBox}" IsReadOnly="True" IsEnabled="False"/>
                    <Button x:Name="FolderBrowseButton" Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Click="FolderBrowseButton_Click"/>
                </Grid>
                <TextBlock x:Name="ProjectFolderHelpText" Text="New project will be created at:" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                <TextBlock x:Name="ProjectFolderPreviewText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>

                <TextBlock Text="Approved CEI Word template (.docx) *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TemplateBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Click="TemplateBrowseButton_Click"/>
                </Grid>

                <Border Style="{StaticResource SectionDividerStyle}" Margin="0,18,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPersonBadgeGeometry}" Style="{StaticResource SectionIconPath}"/>
                        <TextBlock Text="Signature Images" Style="{StaticResource SectionTitleText}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Stored in the project's Signatures folder." Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Open Signatures Folder" Width="150" Style="{StaticResource SecondaryButton}" Padding="8,4"
                            Click="OpenSignatureFolderButton_Click"/>
                    <Button Content="Refresh" Width="90" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Padding="8,4"
                            Click="RefreshSignaturesButton_Click"/>
                </StackPanel>

                <TextBlock Text="Special Inspector signature *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="InspectorSigCombo" Grid.Column="0" IsEditable="False"
                              Padding="4,3" FontSize="13"/>
                    <Button Grid.Column="1" Content="Import..." Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Padding="10,4"
                            Click="InspectorSigImportButton_Click"/>
                </Grid>

                <TextBlock Text="Project Manager signature *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PMSigCombo" Grid.Column="0" IsEditable="False"
                              Padding="4,3" FontSize="13"/>
                    <Button Grid.Column="1" Content="Import..." Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Padding="10,4"
                            Click="PMSigImportButton_Click"/>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="8,5"
                    IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save Project" Width="120" Style="{StaticResource PrimaryButton}" Padding="8,5"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
