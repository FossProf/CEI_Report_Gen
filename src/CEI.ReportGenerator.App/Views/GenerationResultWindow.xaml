<Window x:Class="CEI.ReportGenerator.App.Views.GenerationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Generated"
        Width="620" Height="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionDividerStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCheckCircleGeometry}" Style="{StaticResource SectionIconPath}" Fill="{StaticResource StatusReadyBrush}"/>
                    <TextBlock Text="The report has been generated." Style="{StaticResource PageTitleText}"/>
                </StackPanel>
                <TextBlock Text="Review the document before accepting it as the final report."
                           Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top" Margin="0,12,0,0">
            <TextBox x:Name="PathText" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                     Background="Transparent" MaxHeight="110"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open Report" Width="110" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="8,5"
                    Click="OpenReportButton_Click"/>
            <Button Content="Open Report Folder" Width="130" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="8,5"
                    Click="OpenFolderButton_Click"/>
            <Button Content="Back to Editor" Width="120" Margin="0,0,8,0" Style="{StaticResource QuietButton}" Padding="8,5"
                    IsCancel="True"/>
            <Button x:Name="AcceptButton" Content="Accept as Final" Width="130" Style="{StaticResource PrimaryButton}" Padding="8,5"
                    IsDefault="True" Click="AcceptButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
