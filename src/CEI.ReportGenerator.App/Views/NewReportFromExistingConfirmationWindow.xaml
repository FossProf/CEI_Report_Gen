<Window x:Class="CEI.ReportGenerator.App.Views.NewReportFromExistingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Report from Selected"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap">
            <Run Text="The following information will be copied:"/>
            <LineBreak/>
            <Run Text="- Location"/>
            <LineBreak/>
            <Run Text="- Inspector"/>
            <LineBreak/>
            <Run Text="- Personnel on Site"/>
            <LineBreak/>
            <Run Text="- Description of Work"/>
            <LineBreak/>
            <Run Text="- Drawings Reviewed"/>
        </TextBlock>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap">
            <Run Text="The following will start blank:"/>
            <LineBreak/>
            <Run Text="- Weather"/>
            <LineBreak/>
            <Run Text="- Temperature"/>
            <LineBreak/>
            <Run Text="- Observations"/>
            <LineBreak/>
            <Run Text="- Discrepancies"/>
            <LineBreak/>
            <Run Text="- Photos"/>
            <LineBreak/>
            <LineBreak/>
            <Run x:Name="NewReportNumberText"/>
            <LineBreak/>
            <Run x:Name="NewReportDateText"/>
        </TextBlock>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,8,0"
                    Padding="10,5"
                    Content="Create Report"
                    IsDefault="True"
                    Click="CreateReportButton_Click"/>
            <Button Width="80"
                    Padding="10,5"
                    Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
