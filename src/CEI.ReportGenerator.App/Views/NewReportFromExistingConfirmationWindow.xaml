<Window x:Class="CEI.ReportGenerator.App.Views.NewReportFromExistingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Report from Selected"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconCopyGeometry}" Style="{StaticResource SectionIconPath}"/>
            <TextBlock x:Name="PromptText"
                       Style="{StaticResource PageTitleText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource PanelCardStyle}">
            <TextBlock TextWrapping="Wrap">
            <Run Text="The following information will be copied:"/>
            <LineBreak/>
            <Run Text="- Location"/>
            <LineBreak/>
            <Run Text="- Inspector"/>
            <LineBreak/>
            <Run Text="- Personnel on Site"/>
            <LineBreak/>
            <Run Text="- Description of Work"/>
            <LineBreak/>
            <Run Text="- Drawings Reviewed"/>
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource PanelCardStyle}">
            <TextBlock TextWrapping="Wrap">
            <Run Text="The following will start blank:"/>
            <LineBreak/>
            <Run Text="- Weather"/>
            <LineBreak/>
            <Run Text="- Temperature"/>
            <LineBreak/>
            <Run Text="- Observations"/>
            <LineBreak/>
            <Run Text="- Discrepancies"/>
            <LineBreak/>
            <Run Text="- Photos"/>
            <LineBreak/>
            <LineBreak/>
            <Run x:Name="NewReportNumberText"/>
            <LineBreak/>
            <Run x:Name="NewReportDateText"/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Padding="10,5"
                    Content="Create Report"
                    IsDefault="True"
                    Click="CreateReportButton_Click"/>
            <Button Width="80"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,5"
                    Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
