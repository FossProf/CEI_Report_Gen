<Window x:Class="CEI.ReportGenerator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CEI Report Generator"
        Height="480" Width="680"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProjectMenuItem_Click"/>
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" Click="OpenProjectMenuItem_Click"/>
                <MenuItem x:Name="RecentProjectsMenuItem" Header="_Recent Projects"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                       Text="Special Inspection Report Generator" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="Create or open a project, then generate inspection reports from the approved CEI template."
                       Foreground="#666666" Margin="0,0,0,12"/>

            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Projects" FontWeight="SemiBold" Margin="10,8,10,4"/>
                    <ListBox x:Name="RecentList" Grid.Row="1" Margin="6,0,6,6"
                             MouseDoubleClick="RecentList_MouseDoubleClick"
                             SelectionChanged="RecentList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from list" Click="RemoveRecentItem_Click" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FolderPath}" Foreground="#777777" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenSelectedButton" Content="Open Selected" Width="120" Margin="0,0,8,0"
                        Padding="8,5" Click="OpenSelectedButton_Click"/>
                <Button x:Name="RemoveSelectedButton" Content="Remove Selected" Width="130" Margin="0,0,8,0"
                        Padding="8,5" Click="RemoveSelectedButton_Click"/>
                <Button x:Name="OpenProjectButton" Content="Open Project..." Width="130" Margin="0,0,8,0"
                        Padding="8,5" Click="OpenProjectButton_Click"/>
                <Button x:Name="NewProjectButton" Content="New Project..." Width="130"
                        Padding="8,5" Click="NewProjectButton_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
