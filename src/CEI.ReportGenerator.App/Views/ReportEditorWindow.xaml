<Window x:Class="CEI.ReportGenerator.App.Views.ReportEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspection Report"
        Height="760" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Style="{StaticResource SectionDividerStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFileEarmarkTextGeometry}" Style="{StaticResource SectionIconPath}"/>
                    <TextBlock x:Name="ReportNumberText" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Report #" Style="{StaticResource FieldLabel}" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ReportNumberBox" Width="80" VerticalAlignment="Center" Style="{StaticResource FieldBox}"/>
                <TextBlock Text="Inspection date *" Style="{StaticResource FieldLabel}" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="DatePicker" Width="160" VerticalAlignment="Center" SelectedDateFormat="Long"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Report Details">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Temperature (&#176;F)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TemperatureBox"
                                         Style="{StaticResource FieldBox}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         TextChanged="TemperatureBox_TextChanged"/>
                                <CheckBox x:Name="AutoTemperatureCheckBox"
                                          Content="Auto"
                                          Margin="12,6,0,0"
                                          VerticalAlignment="Top"
                                          ToolTip="Automatically look up temperature using the project location and inspection date."
                                          Checked="AutoTemperatureCheckBox_Checked"
                                          Unchecked="AutoTemperatureCheckBox_Unchecked"/>
                            </StackPanel>
                            <TextBlock x:Name="TemperatureLookupStatusText"
                                       Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="Weather *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="WeatherCombo" Width="200" HorizontalAlignment="Left"
                                      IsEditable="False" Padding="4,3" FontSize="13"/>

                            <TextBlock Text="Location(s) inspected *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LocationBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Cornerstone Inspector(s) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="InspectorBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Personnel on site *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PersonnelBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Description and location(s) of work inspected *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldBox}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Drawing sheets and sections related to this work *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DrawingBox" Style="{StaticResource FieldBox}" Height="50"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Discrepancies and direction given" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NewDiscrepancyBox" Style="{StaticResource FieldBox}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Observations on correction of discrepancies noted in previous inspections" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OldDiscrepancyBox" Style="{StaticResource FieldBox}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="General observations / remarks" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="ObservationBox" Grid.Row="1" MinHeight="140" Style="{StaticResource FieldBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Photos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Add Photo..." Width="110" Style="{StaticResource SecondaryButton}" Padding="6,3" Click="AddPhotoButton_Click"/>
                        <Button x:Name="RemovePhotoButton" Content="Remove Selected" Width="120" Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}" Padding="6,3" Click="RemovePhotoButton_Click"/>
                        <Button x:Name="MoveUpPhotoButton" Content="Move Up" Width="85" Margin="8,0,0,0"
                                Style="{StaticResource QuietButton}" Padding="6,3" Click="MoveUpPhotoButton_Click"/>
                        <Button x:Name="MoveDownPhotoButton" Content="Move Down" Width="90" Margin="8,0,0,0"
                                Style="{StaticResource QuietButton}" Padding="6,3" Click="MoveDownPhotoButton_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="PhotoList" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PhotoList_PreviewMouseMove"
                                 DragOver="PhotoList_DragOver"
                                 Drop="PhotoList_Drop"
                                 SelectionChanged="PhotoList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" MinWidth="64" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="96" Height="72"
                                                Background="{StaticResource SurfaceBrush}" Margin="0,0,10,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="92" MaxHeight="68" Margin="2"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Caption:" Margin="0,4,0,2" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="44"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="PhotoEmptyState"
                                Background="#66FFFFFF"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="18"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Drag image files here"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="or"
                                           Margin="0,10,0,10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Use Add Photo..."
                                           FontSize="16"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FinalMetadataNoteText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"
                       Visibility="Collapsed"
                       Text="Changes update SPINgen metadata only.&#10;The finalized Word report is not modified."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveDraftButton" Content="Save Draft" Width="110" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="8,5"
                        Click="SaveDraftButton_Click"/>
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" Style="{StaticResource QuietButton}" Padding="8,5"
                        IsCancel="True"/>
                <Button x:Name="GenerateButton" Content="Generate Report" Width="140" Style="{StaticResource PrimaryButton}" Padding="8,5"
                        IsDefault="True" Click="GenerateButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
