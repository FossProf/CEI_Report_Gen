<Window x:Class="CEI.ReportGenerator.App.Views.ReportEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspection Report"
        Height="760" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="ReportNumberText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="Report #" Style="{StaticResource FieldLabel}" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ReportNumberBox" Width="80" VerticalAlignment="Center" Style="{StaticResource FieldBox}"/>
                <TextBlock Text="Inspection date *" Style="{StaticResource FieldLabel}" Margin="20,0,6,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="DatePicker" Width="160" VerticalAlignment="Center" SelectedDateFormat="Long"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Report Details">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Temperature (°F)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TemperatureBox" Style="{StaticResource FieldBox}" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Text="Weather *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="WeatherCombo" Width="200" HorizontalAlignment="Left"
                                      IsEditable="False" Padding="4,3" FontSize="13"/>

                            <TextBlock Text="Location(s) inspected *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LocationBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Cornerstone Inspector(s) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="InspectorBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Personnel on site *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PersonnelBox" Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Description and location(s) of work inspected *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldBox}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Drawing sheets and sections related to this work *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DrawingBox" Style="{StaticResource FieldBox}" Height="50"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Discrepancies and direction given" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NewDiscrepancyBox" Style="{StaticResource FieldBox}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Observations on correction of discrepancies noted in previous inspections" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OldDiscrepancyBox" Style="{StaticResource FieldBox}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="General observations / remarks" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="ObservationBox" Grid.Row="1" MinHeight="140"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Photos">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Photo..." Width="110" Padding="6,3" Click="AddPhotoButton_Click"/>
                            <Button x:Name="RemovePhotoButton" Content="Remove Selected" Width="120" Margin="8,0,0,0"
                                    Padding="6,3" Click="RemovePhotoButton_Click"/>
                            <Button x:Name="MoveUpPhotoButton" Content="Move Up" Width="85" Margin="8,0,0,0"
                                    Padding="6,3" Click="MoveUpPhotoButton_Click"/>
                            <Button x:Name="MoveDownPhotoButton" Content="Move Down" Width="90" Margin="8,0,0,0"
                                    Padding="6,3" Click="MoveDownPhotoButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="Drag image files here, or drag rows to reorder. Photo 1 appears first."
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#777777" FontSize="12"/>
                    </Grid>

                    <ListBox x:Name="PhotoList" Grid.Row="1" AllowDrop="True"
                             PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PhotoList_PreviewMouseMove"
                             DragOver="PhotoList_DragOver"
                             Drop="PhotoList_Drop"
                             SelectionChanged="PhotoList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MinWidth="64" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Width="96" Height="72"
                                            Background="White" Margin="0,0,10,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="92" MaxHeight="68" Margin="2"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Caption:" Margin="0,4,0,2" FontSize="11" Foreground="#777777"/>
                                        <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="44"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save Draft" Width="100" Margin="0,0,8,0" Padding="8,5"
                    Click="SaveDraftButton_Click"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="8,5"
                    IsCancel="True"/>
            <Button x:Name="GenerateButton" Content="Generate Report" Width="140" Padding="8,5"
                    IsDefault="True" Click="GenerateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
