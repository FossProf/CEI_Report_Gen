<Window x:Class="CEI.ReportGenerator.App.Views.GenerationErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Generation Failed"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Review the issues below. Nothing was written to the report folder." Foreground="#555555"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8"
                Margin="0,12,0,0">
            <TextBox x:Name="ErrorListText" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                     Background="Transparent"/>
        </Border>

        <TextBlock x:Name="LogPathText" Grid.Row="1" Foreground="#777777" FontSize="11"
                   TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="2,8,2,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy Diagnostic Details" Width="160" Margin="0,0,8,0" Padding="8,5"
                    Click="CopyButton_Click"/>
            <Button Content="Open Log Folder" Width="120" Margin="0,0,8,0" Padding="8,5"
                    Click="OpenLogButton_Click"/>
            <Button Content="Close" Width="90" Padding="8,5" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
