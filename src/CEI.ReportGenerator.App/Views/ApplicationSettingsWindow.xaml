<Window x:Class="CEI.ReportGenerator.App.Views.ApplicationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="330" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Application Settings" Margin="0,0,0,12"/>

            <TextBlock Text="Projects" FontWeight="SemiBold"/>
            <Separator Margin="0,4,0,8"/>

            <TextBlock Text="Default projects folder:" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultProjectsFolderBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="10,4"
                        Click="BrowseDefaultFolderButton_Click"/>
            </Grid>

            <TextBlock Text="Recent projects shown:" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RecentProjectLimitBox" Width="90" HorizontalAlignment="Left" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Separator Margin="0,4,0,8"/>
            <CheckBox x:Name="ReopenLastProjectCheckBox"
                      Content="Reopen last project when CEI Report Generator starts"/>

            <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Restore Defaults" Width="120" Margin="0,0,8,0" Padding="8,5"
                    Click="RestoreDefaultsButton_Click"/>
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Padding="8,5"
                    IsCancel="True"/>
            <Button Content="Save" Width="100" Padding="8,5"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
