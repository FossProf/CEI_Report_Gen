<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CEI.ReportImporter.App</RootNamespace>
    <AssemblyName>CEI.ReportImporter.App</AssemblyName>
    <Product>SPINgen Historical Importer</Product>
    <AssemblyTitle>SPINgen Historical Importer</AssemblyTitle>
    <Company>Cornerstone Engineering / CEI</Company>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-alpha</InformationalVersion>
    <Description>Windows desktop application for scanning and parsing historical CEI SPIN reports.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CEI.ReportGenerator.Core\CEI.ReportGenerator.Core.csproj" />
    <ProjectReference Include="..\CEI.ReportImporter.Core\CEI.ReportImporter.Core.csproj" />
  </ItemGroup>

</Project>
