<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <OutputName>$(ReleaseProductName)_$(ReleaseInformationalVersion)_x64</OutputName>
    <SuppressIces>ICE61</SuppressIces>
    <DefineConstants>PublishDir=$(PublishDir);AppIconPath=$(AppIconPath);ReleaseProductName=$(ReleaseProductName);ReleaseProductVersion=$(ReleaseProductVersion);ReleaseInformationalVersion=$(ReleaseInformationalVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
